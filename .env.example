# Any OpenAI-compatible chat API. Default: Google Gemini (free key at https://aistudio.google.com/apikey).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_ROUTER_MODEL=gemini-2.5-flash-lite
# "none" turns off Gemini's thinking for faster replies; leave empty for models that don't support it.
LLM_REASONING_EFFORT=none

# Protects POST /api/admin/refresh and GET /api/admin/unanswered. Admin endpoints are off when empty.
ADMIN_TOKEN=

# Optional: also POST each quote request to this URL (e.g. an n8n or Zapier webhook).
LEAD_WEBHOOK_URL=
QUOTE_URL=https://www.placidway.com/contact-us
RATE_LIMIT_PER_MINUTE=20
