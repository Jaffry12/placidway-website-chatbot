# Any OpenAI-compatible chat API. Default: Google Gemini (free key at https://aistudio.google.com/apikey).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Free-tier quotas are per model (Flash-Lite ~500 requests/day; Flash only 20/day), so the router
# and the answerer use different Lite models.
LLM_MODEL=gemini-3.5-flash-lite
LLM_ROUTER_MODEL=gemini-3.1-flash-lite
# Gemini "thinking" level per model ("none", "low", ...). Leave empty for the model's default.
LLM_REASONING_EFFORT=low
LLM_ROUTER_REASONING_EFFORT=
# Tried in order when a model is overloaded or out of quota.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3.5-flash
# Free-tier latency is spiky: if a model hasn't answered after this many seconds, race the next one.
LLM_HEDGE_AFTER_S=4
# Hard cap (seconds) for one model call including fallbacks.
LLM_BUDGET_S=25

# Protects POST /api/admin/refresh and GET /api/admin/unanswered. Admin endpoints are off when empty.
ADMIN_TOKEN=

# Optional: also POST each quote request to this URL (e.g. an n8n or Zapier webhook).
LEAD_WEBHOOK_URL=
QUOTE_URL=https://www.placidway.com/contact-us
RATE_LIMIT_PER_MINUTE=20
